    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO conversation_history (client_phone, role, content, intent, agent)\nVALUES ('{{ $json.phone }}', 'system', 'router dispatched to {{ $json.intent }}', '{{ $json.intent }}', 'router');"
      },
      "id": "save_history",
