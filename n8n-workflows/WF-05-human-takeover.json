        "jsonBody": "={\"messaging_product\":\"whatsapp\",\"to\":\"{{$json.phone}}\",\"type\":\"text\",\"text\":{\"body\":\"Perfeito, vou te transferir para nosso atendimento humano agora. Ja te respondemos por aqui em instantes.\"}}"
