        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"message\":\"Escalacao automatica iniciada para atendimento humano.\",\"status\":\"open\",\"custom_attributes\":{\"source\":\"n8n\",\"reason\":\"{{$json.handoff_reason || 'router_or_faq'}}\"}}",
        "options": {
          "ignoreResponseCode": true
        }
      },
      "id": "create_chatwoot_conversation",
      "name": "Create Chatwoot Conversation",
