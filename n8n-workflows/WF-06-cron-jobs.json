    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id AS client_id, c.phone, c.name, c.last_service\nFROM clients c\nWHERE c.opted_out = false\n  AND (c.last_visit IS NULL OR c.last_visit < NOW() - INTERVAL '30 day')\n  AND NOT EXISTS (\n    SELECT 1\n    FROM proactive_messages pm\n    WHERE pm.client_id = c.id\n      AND pm.sent_at > NOW() - INTERVAL '7 day'\n  );"
      },
