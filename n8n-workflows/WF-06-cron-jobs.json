      "parameters": {
        "jsCode": "const raw = items[0]?.json || {};\nconst list = raw.data || raw.appointments || raw.items || [];\nif (!Array.isArray(list) || list.length === 0) return [];\nreturn list.map((a) => ({ json: {\n  client_id: a.client_id || a.client?.id || null,\n  phone: a.phone || a.client?.phone || '',\n  name: a.name || a.client?.name || 'Cliente',\n  service: a.service || a.service_name || '',\n  time: a.time || a.start_time || '',\n  professional: a.professional || a.professional_name || ''\n}}));"
