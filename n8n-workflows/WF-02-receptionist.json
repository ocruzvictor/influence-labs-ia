    {
      "parameters": {
        "method": "GET",
        "url": "={{($vars.TRINKS_API_BASE_URL || 'https://api.trinks.com/v1') + '/agendamentos/profissionais/' + $json.requested_date}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{$vars.TRINKS_API_KEY}}"
            },
            {
              "name": "estabelecimentoId",
              "value": "={{$vars.TRINKS_SALON_ID || '243868'}}"
            }
