    {
      "parameters": {
        "method": "GET",
        "url": "={{($env.TRINKS_API_BASE_URL || \"https://api.trinks.com/v1\") + \"/appointments/availability\"}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.TRINKS_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "date",
              "value": "={{$json.requested_date}}"
            },
            {
              "name": "professional",
              "value": "={{$json.professional || \"\"}}"
            },
            {
              "name": "duration_minutes",
              "value": "={{$json.duration_minutes || 60}}"
            }
          ]
        }
      },
      "id": "check_availability",
      "name": "Check Availability",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -660,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $items('Parse Booking Context', 0, 0)[0].json;\n\nlet availableSlots = [];\nif (Array.isArray(items) && items.length > 0) {\n  const raw = items[0].json || {};\n  if (Array.isArray(raw.slots)) {\n    availableSlots = raw.slots.map((s) => s.time || s.start_time || s).filter(Boolean);\n  } else if (Array.isArray(raw.data?.slots)) {\n    availableSlots = raw.data.slots.map((s) => s.time || s.start_time || s).filter(Boolean);\n  } else {\n    availableSlots = items.map(i => i.json.available_time).filter(Boolean);\n  }\n}\n\nconst systemPrompt = `# Recepcionista - Studio Tirra\\n\\n## PERSONA\\nAssistente Virtual Studio Tirra. Empatica, objetiva e consultiva.\\n\\n## ACTION\\nGerenciar agendamento, reagendamento, cancelamento, consulta e confirmacao.\\n\\n## REGRAS\\n- Nunca inventar horarios.\\n- Sempre validar disponibilidade no Trinks.\\n- Confirmacao tripla obrigatoria.\\n- Em caso de conflito/reclamacao, escalar para Gabriel.\\n\\nRetorne JSON com campos: action, response_text, service, professional, date, time, duration_minutes.`;\n\nconst userPrompt = `Mensagem cliente: ${input.message}\\nData solicitada: ${input.requested_date}\\nServico detectado: ${input.service || 'nao identificado'}\\nProfissional detectado: ${input.professional || 'nao identificado'}\\nAVAILABLE_SLOTS: ${availableSlots.join(', ') || 'sem vagas'}\\n\\nResponda somente JSON.`;\n\nreturn [{\n  json: {\n    ...input,\n    available_slots: availableSlots,\n    system_prompt: systemPrompt,\n    user_prompt: userPrompt,\n    llm_provider: ($env.LLM_PROVIDER || 'openai').toLowerCase()\n  }\n}];"
      },
      "id": "build_prompt",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -440,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.llm_provider === 'anthropic' ? 'https://api.anthropic.com/v1/messages' : 'https://api.openai.com/v1/responses'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENAI_API_KEY}}"
            },
            {
              "name": "x-api-key",
              "value": "={{$env.ANTHROPIC_API_KEY}}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{$json.llm_provider === 'anthropic' ? JSON.stringify({model: $env.ANTHROPIC_MODEL || 'claude-3-5-sonnet-latest', max_tokens: 500, temperature: 0.2, system: $json.system_prompt, messages: [{role: 'user', content: $json.user_prompt}]}) : JSON.stringify({model: $env.OPENAI_MODEL || 'gpt-4o-mini', temperature: 0.2, input: [{role: 'system', content: $json.system_prompt}, {role: 'user', content: $json.user_prompt}]})}}"
      },
      "id": "call_llm",
      "name": "Call LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -220,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = $items('Build Prompt', 0, 0)[0].json;\nlet payload = {\n  action: 'consultar',\n  response_text: 'Vou verificar com a equipe e ja te retorno!',\n  service: source.service || 'Corte feminino',\n  professional: source.professional || 'Carla',\n  date: source.requested_date,\n  time: source.available_slots?.[0] || null,\n  duration_minutes: source.duration_minutes || 60\n};\n\nlet text = '';\nif ($json.output?.[0]?.content?.[0]?.text) text = $json.output[0].content[0].text;\nif (!text && Array.isArray($json.content) && $json.content[0]?.text) text = $json.content[0].text;\n\ntry {\n  payload = { ...payload, ...JSON.parse(text) };\n} catch (e) {}\n\nconst allowed = ['agendar', 'reagendar', 'cancelar', 'consultar', 'confirmar'];\nif (!allowed.includes(payload.action)) payload.action = 'consultar';\n\nif (payload.action === 'agendar' && payload.time && !source.available_slots.includes(payload.time)) {\n  payload.action = 'consultar';\n  payload.response_text = `Esse horario nao esta disponivel. Tenho: ${source.available_slots.join(', ')}. Qual prefere?`;\n}\n\nif (!payload.response_text) {\n  payload.response_text = 'Perfeito. Vou te ajudar com isso agora.';\n}\n\nreturn [{ json: { ...source, ...payload } }];"
      },
