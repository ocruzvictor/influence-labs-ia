        }
      },
      "id": "check_availability",
      "name": "Check Availability",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -660,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $items('Parse Booking Context', 0, 0)[0].json;\n\nlet availableSlots = [];\nlet slotsSummary = '';\nconst raw = items[0].json || {};\nif (raw.data && Array.isArray(raw.data)) {\n  const available = raw.data.filter(p => p.horariosVagos && p.horariosVagos.length > 0);\n  if (available.length > 0) {\n    const parts = [];\n    for (const p of available) {\n      parts.push(`${p.apelido || p.nome}: ${p.horariosVagos.join(', ')}`);\n      availableSlots = availableSlots.concat(p.horariosVagos);\n    }\n    slotsSummary = parts.join(' | ');\n  }\n}\n\nconst systemPrompt = `# Recepcionista - Studio Tirra\\n\\n## PERSONA\\nAssistente Virtual Studio Tirra. Empatica, objetiva e consultiva.\\n\\n## ACTION\\nGerenciar agendamento, reagendamento, cancelamento, consulta e confirmacao.\\n\\n## REGRAS\\n- Nunca inventar horarios.\\n- Sempre validar disponibilidade no Trinks.\\n- Confirmacao tripla obrigatoria.\\n- Em caso de conflito/reclamacao, escalar para a recepção.\\n\\nRetorne JSON com campos: action, response_text, service, professional, date, time, duration_minutes.`;\n\nconst userPrompt = `Mensagem cliente: ${input.message}\\nData solicitada: ${input.requested_date}\\nServico detectado: ${input.service || 'nao identificado'}\\nProfissional detectado: ${input.professional || 'nao identificado'}\\nHORARIOS VAGOS: ${slotsSummary || 'sem vagas'}\\n\\nResponda somente JSON.`;\n\nreturn [{\n  json: {\n    ...input,\n    available_slots: availableSlots,\n    slots_summary: slotsSummary,\n    system_prompt: systemPrompt,\n    user_prompt: userPrompt\n  }\n}];"
      },
      "id": "build_prompt",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -440,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{($vars.TESS_API_BASE || 'https://api.tess.im') + '/agents/' + ($vars.TESS_AGENT_ID || '33200') + '/execute'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$vars.TESS_API_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{JSON.stringify({messages: [{role: 'system', content: $json.system_prompt}, {role: 'user', content: $json.user_prompt}], wait_execution: true})}}"
      },
      "id": "call_llm",
      "name": "Call TESS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -220,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const source = $items('Build Prompt', 0, 0)[0].json;\nlet payload = {\n  action: 'consultar',\n  response_text: 'Vou verificar com a equipe e ja te retorno!',\n  service: source.service || null,\n  professional: source.professional || null,\n  date: source.requested_date,\n  time: source.available_slots?.[0] || null,\n  duration_minutes: source.duration_minutes || 60\n};\n\nlet text = '';\nconst raw = $json;\nif (raw.responses?.[0]?.output) text = String(raw.responses[0].output);\nelse if (raw.output) text = String(raw.output);\nelse if (raw.choices?.[0]?.message?.content) text = raw.choices[0].message.content;\nelse if (Array.isArray(raw.content) && raw.content[0]?.text) text = raw.content[0].text;\nelse if (raw.response) text = String(raw.response);\nelse if (raw.text) text = String(raw.text);\n\ntry {\n  payload = { ...payload, ...JSON.parse(text) };\n} catch (e) {\n  payload.response_text = text || payload.response_text;\n}\n\nconst allowed = ['agendar', 'reagendar', 'cancelar', 'consultar', 'confirmar'];\nif (!allowed.includes(payload.action)) payload.action = 'consultar';\n\nif (payload.action === 'agendar' && payload.time && !source.available_slots.includes(payload.time)) {\n  payload.action = 'consultar';\n  payload.response_text = `Esse horario nao esta disponivel. Tenho: ${source.available_slots.join(', ')}. Qual prefere?`;\n}\n\nif (!payload.response_text) {\n  payload.response_text = 'Perfeito. Vou te ajudar com isso agora.';\n}\npayload.response_text = (payload.response_text || '').replace(/'/g, \"''\");\n\nreturn [{ json: { ...source, ...payload } }];"
      },
