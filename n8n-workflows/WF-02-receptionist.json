        -1320,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $json;\nconst msg = (input.message || '').toLowerCase();\nconst now = new Date();\nconst tomorrow = new Date(now.getTime() + 24 * 60 * 60 * 1000);\nconst isoToday = now.toISOString().slice(0, 10);\nconst isoTomorrow = tomorrow.toISOString().slice(0, 10);\n\nlet requested_date = isoToday;\nif (msg.includes('amanha')) requested_date = isoTomorrow;\n\nconst serviceDurations = {\n  'corte masculino': 60,\n  'corte feminino': 120,\n  'cabelo e barba': 60,\n  'barba': 30,\n  'visagismo': 120,\n  'mechas': 330,\n  'progressiva': 120,\n  'manicure': 60,\n  'pedicure': 60\n};\n\nlet service = '';\nObject.keys(serviceDurations).forEach((name) => {\n  if (msg.includes(name)) service = name;\n});\n\nlet professional = '';\nconst aliases = {\n  'tiago': 'Tiago Rocha',\n  'andre': 'Andre de Oliveira',\n  'erick': 'Erick Barros',\n  'eli': 'Eliane Santana',\n  'malu': 'Maria Luiza',\n  'maluzinha': 'Maria Luiza',\n  'giovanna': 'Giovanna Ferraz',\n  'jackie': 'Jaqueline Aprigio',\n  'fefe': 'Fernanda de Sousa',\n  'fernanda': 'Fernanda de Sousa'\n};\nObject.keys(aliases).forEach((alias) => {\n  if (msg.includes(alias)) professional = aliases[alias];\n});\n\nconst duration_minutes = serviceDurations[service] || 60;\n\nreturn [{\n  json: {\n    ...input,\n    requested_date,\n    service: service || null,\n    professional: professional || null,\n    duration_minutes,\n    work_start: '09:00',\n    work_end: '19:00'\n  }\n}];"
      },
      "id": "parse_context",
      "name": "Parse Booking Context",
