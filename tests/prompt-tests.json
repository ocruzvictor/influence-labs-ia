  "receptionist_tests": [
    {
      "input": "Quero cortar cabelo e barba quinta as 14h com o Tiago",
      "context": {
        "available_slots": [
          "14:00",
          "15:00"
        ]
      },
      "expected_contains": [
        "cabelo",
        "barba",
        "Tiago",
        "14"
      ],
      "expected_not_contains": [
        "inventei",
        "talvez"
      ]
    },
    {
